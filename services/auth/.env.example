DATABASE_URL="postgresql://owntime:owntime@localhost:5433/owntime_auth?schema=public"
PORT=3001                              # local dev; the container listens on 3000
CORS_ORIGIN="http://localhost:5173"    # comma-separated allowlist; also the CSRF Origin allowlist for /auth/refresh + /auth/logout

# Auth — see docs/adr/0004 (base), docs/adr/0005 (hardening), docs/adr/0006 (service split)
GOOGLE_CLIENT_ID=""                    # OAuth 2.0 Web client id from Google Cloud Console; same value as the frontend's VITE_GOOGLE_CLIENT_ID
# RS256 signing key (PKCS#8 PEM, base64-encoded onto one line). This service
# holds the private key; other services verify via GET /auth/.well-known/jwks.json.
# Generate: openssl genpkey -algorithm RSA -pkcs8 -outform PEM | base64
# Leave empty in dev to auto-generate an ephemeral keypair (invalidated on restart).
AUTH_JWT_PRIVATE_KEY=""
AUTH_ACCESS_TOKEN_TTL="5m"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
AUTH_ALLOW_DEV_HEADER="true"           # accepts the x-user-id header without a token; ignored when NODE_ENV=production — MUST be false anywhere exposed
