# Leave VITE_API_URL empty (or unset) to use same-origin requests — the Vite
# dev server / the UI service's nginx proxy /auth, /preferences, /todos and
# /scribe to the right backend service (ADR 0006). Only set it to point the
# SPA straight at a single backend origin, bypassing the proxy.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=            # same OAuth client id as the auth service's GOOGLE_CLIENT_ID; leave empty to use dev mode only
