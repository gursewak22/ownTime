DATABASE_URL="postgresql://owntime:owntime@localhost:5434/owntime_tools?schema=public"
PORT=3002                              # local dev; the container listens on 3000
CORS_ORIGIN="http://localhost:5173"    # comma-separated allowlist (only relevant when bypassing the UI proxy)

# Where to fetch the auth service's public signing keys (ADR 0006). Inside the
# deploy network this is http://auth:3000/auth/.well-known/jwks.json.
AUTH_JWKS_URL="http://localhost:3001/auth/.well-known/jwks.json"
AUTH_ALLOW_DEV_HEADER="true"           # accepts the x-user-id header without a token; ignored when NODE_ENV=production — MUST be false anywhere exposed
