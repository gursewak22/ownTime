DATABASE_URL="postgresql://owntime:owntime@localhost:5435/owntime_assistant?schema=public"
PORT=3003                              # local dev; the container listens on 3000
CORS_ORIGIN="http://localhost:5173"    # comma-separated allowlist (only relevant when bypassing the UI proxy)

# Where to fetch the auth service's public signing keys (ADR 0006). Inside the
# deploy network this is http://auth:3000/auth/.well-known/jwks.json.
AUTH_JWKS_URL="http://localhost:3001/auth/.well-known/jwks.json"
AUTH_ALLOW_DEV_HEADER="true"           # accepts the x-user-id header without a token; ignored when NODE_ENV=production — MUST be false anywhere exposed

# Base URL of the tools service — the agent calls /todos through it with the
# user's forwarded credentials. Inside the deploy network: http://tools:3000.
TOOLS_URL="http://localhost:3002"

# Secret used to encrypt users' Anthropic API keys at rest (AES-256-GCM; the
# actual cipher key is sha256 of this string). Rotating it orphans every stored
# key — users would have to re-enter theirs. Set a long random value in prod.
ASSISTANT_KEY_SECRET="dev-only-secret-change-me"
