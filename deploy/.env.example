# Copy to deploy/.env and fill in. Compose refuses to start without the two
# required values.

# --- required ---------------------------------------------------------------
# OAuth 2.0 Web client id from Google Cloud Console (used by auth + baked into
# the UI build; they must match).
GOOGLE_CLIENT_ID=

# RS256 signing key: PKCS#8 PEM, base64-encoded onto one line.
# Generate: openssl genpkey -algorithm RSA -pkcs8 -outform PEM | base64 | tr -d '\n'
AUTH_JWT_PRIVATE_KEY=

# --- optional ---------------------------------------------------------------
# Browser-facing origin of the UI (CORS + CSRF allowlist on the auth service).
PUBLIC_ORIGIN=http://localhost:8080
# Host port the UI publishes.
UI_PORT=8080
# Refresh cookie Secure flag: keep true behind HTTPS; false for TLS-less LAN.
AUTH_COOKIE_SECURE=false
# Per-service database passwords (default 'owntime'; change for anything shared).
AUTH_DB_PASSWORD=owntime
TOOLS_DB_PASSWORD=owntime
